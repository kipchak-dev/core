{
  "name": "mamluk/kipchak",
  "type": "library",
  "description": "An API Development Kit (ADK) to consistently build and manage APIs",
  "keywords": [
    "APIs",
    "microservices"
  ],
  "homepage": "https://mamluk.net",
  "license": "MIT",
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": ">=8.3",
    "doctrine/orm": "^3.5",
    "zircote/swagger-php": "^5.7",
    "firebase/php-jwt": "^6.9",
    "guzzlehttp/guzzle": "^7.10",
    "illuminate/http": "^12.40",
    "monolog/monolog": "^3.9",
    "php-di/php-di": "^7.1",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "symfony/cache": "^6.4",
    "mamluk/couchdb": "0.7",
    "cuyz/valinor": "^1.17"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Mamluk\\Kipchak\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mamluk\\Kipchak\\Tests\\": "tests/"
    }
  }
}
