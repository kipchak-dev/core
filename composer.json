{
  "name": "kipchak/core",
  "type": "library",
  "description": "An API Development Kit (ADK) to consistently build and manage APIs",
  "keywords": [
    "APIs",
    "microservices"
  ],
  "homepage": "https://mamluk.net",
  "license": "MIT",
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": ">=8.4",
    "zircote/swagger-php": "^5.7",
    "firebase/php-jwt": "^6.9",
    "php-di/php-di": "^7.1",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15",
    "cuyz/valinor": "^1.17"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Kipchak\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kipchak\\Core\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
